# =============================================================================
# GITIGNORE RACINE
# =============================================================================
# This file contains global, shared exclusions.
# Subdirectories maintain their own `.gitignore` files for specific exclusions.

# =============================================================================
# PYTHON - SHARED BASE FILES
# =============================================================================
# Bytecode Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
.Python

# Virtual environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/
.conda/

# =============================================================================
# BUILD AND DISTRIBUTION (SHARED)
# =============================================================================
# Build artifacts
build/
!.scripts/build/
dist/
*.egg-info/
*.egg
*.spec

# Packaging
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
.installed.cfg
MANIFEST

# =============================================================================
# CACHE AND TEMPORARY FILES (SHARED)
# =============================================================================
# Development-tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.black_cache/
.bandit/
.pre-commit-cache/
.benchmarks/
.tox/
.cache
.nox/
.hypothesis/
.import_linter_cache/
.grimp_cache/

# Dependency manager cache
.pip-cache/
node_modules/
.npm/
.yarn/

# =============================================================================
# CODE-QUALITY REPORTS AND ANALYSES (SHARED)
# =============================================================================
# Security reports (Bandit)
bandit-report.json
bandit-report.xml
bandit-report.html
bandit_report.html

# Code-coverage reports (pytest-cov, coverage)
.coverage
coverage.xml
htmlcov/
.coverage.*

# Linting and formatting reports
ruff-report.json
flake8-report.txt
black-report.txt
mypy-report.txt

# Test reports
test-results/
.pytest_cache/
junit.xml
test-report.xml
nosetests.xml
*.cover
*.py,cover

# Documentation reports
doc8-report.txt
doc8-report.html

# Complexity and metrics reports
radon-report.json
mccabe-report.txt
complexity-report.html

# Dependency reports
safety-report.json
pip-audit-report.json
dependency-check-report.xml

# Performance reports
py-spy-report.svg
py-spy-report.txt
memory-profiler-report.txt

# Advanced type-checking reports
pyre-report.json
pyright-report.json
pytype-report.txt

# Formatting and style reports
autopep8-report.txt
yapf-report.txt
isort-report.txt

# Advanced security reports
semgrep-report.json
semgrep-report.sarif
codeql-report.json

# General quality reports
sonarqube-report.json
codeclimate-report.json
codacy-report.json

# =============================================================================
# LOGS AND TEMPORARY FILES
# =============================================================================
# Application logs
.logs/
*.log
*.xlsx
*.csv
version_info.txt

# =============================================================================
# IDEs AND EDITORS (SHARED)
# =============================================================================
# Cursor
.cursorignore
.cursor/
.cursor/rules/
.cursor_cache/

# Visual Studio Code
.vscode/
.vscode-server/
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json

# PyCharm/IntelliJ
.idea/
*.iml
*.ipr
*.iws

# Vim/Neovim
*.swp
*.swo
*~

# =============================================================================
# AI AGENT
# =============================================================================
# Cursor
.cursor/
.cursorrules
.cursor/rules/
.cursor/*.mdc
cursor.json

# Claude (Anthropic)
.claude/

# =============================================================================
# SYSTEM FILES (SHARED)
# =============================================================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride

# Linux
.directory
.Trash-*

# =============================================================================
# GLOBAL EXCLUSIONS (SHARED)
# =============================================================================
# Backup files
*.bak
*.backup
*.old
*.orig
*.rej

# Temporary files
*.pid
*.tmp
*.temp
_temp/
temp/
tmp/
tmpclaude-*

# MkDocs build output
site/

# =============================================================================
# ROOT-PROJECT-SPECIFIC EXCLUSIONS
# =============================================================================
# Global and sensitive configuration files
.env
.env.*
.env.local
.env.*.local
.secret*
*password*
*secret*
*.key
*.pem
*.crt
credentials/
keys/

# =============================================================================
# ADDITIONAL PATTERNS
# =============================================================================
# Temporary commit messages
commit_message.txt

# Temporary test files
test_output/
temp_projects/

# Local user configuration
local_config/
user_settings/

# Superpowers plans and specs (development workflow, outside published docs)
.superpowers/
